        android:orientation="vertical"
        android:gravity="center"
        android:minHeight="64dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingLeft="1dp"
        android:paddingRight="1dp">
        <ImageView android:id="@+id/navAnalisaIcon"
            android:layout_width="26dp" android:layout_height="26dp"
            android:src="@drawable/ic_nav_analisa"
            android:tint="#8B93A7"
            android:contentDescription="Analisa" />
        <TextView android:id="@+id/navAnalisaLabel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Analisa" android:textSize="11sp"
            android:singleLine="true" android:ellipsize="none"
            android:gravity="center" android:letterSpacing="-0.04"
            android:includeFontPadding="false"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navHeatmap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:minHeight="64dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingLeft="1dp"
        android:paddingRight="1dp">
        <ImageView android:id="@+id/navHeatmapIcon"
