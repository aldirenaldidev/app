<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp">
        <ImageView
            android:id="@+id/ivPLogo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:background="@drawable/logo_bg"
            android:contentDescription="Logo emiten" />
        <TextView
            android:id="@+id/tvPLogoInit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="BB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/pill_senja" />
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/tvPSym" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BBCA" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/tvPDetail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="10 lot • Avg 9.800" android:textSize="13sp" android:textColor="#8B93A7" />
        <TextView android:id="@+id/tvPValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nilai pasar Rp 10.500.000" android:textSize="13sp" android:textColor="#8B93A7" />
    </LinearLayout>

    <TextView android:id="@+id/tvPPnl" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="+Rp 700rb&#10;+7,14%" android:textSize="13sp" android:textStyle="bold" android:textColor="#16C784"
        android:background="@drawable/pill_up" android:paddingLeft="12dp" android:paddingRight="12dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center" />
</LinearLayout>
