<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F1A">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analisa Teknikal"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skor &amp; alasan BELI / TAHAN / JUAL dari 13 indikator"
            android:textSize="12sp"
            android:textColor="#8B93A7"
            android:layout_marginTop="2dp" />

        <!-- SEARCH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <AutoCompleteTextView
                android:id="@+id/etAnalisaSym"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Ketik kode/nama emiten…"
                android:textColor="#FFFFFF"
                android:textColorHint="#8B93A7"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:inputType="textCapCharacters"
                android:completionThreshold="1"
                android:popupBackground="#151B2E"
                android:dropDownWidth="match_parent" />

            <Space android:layout_width="8dp" android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnAnalisaGo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analisa"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_primary"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:minHeight="52dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAnalisaStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih emiten lalu tap Analisa."
            android:textSize="12sp"
            android:textColor="#8B93A7"
            android:layout_marginTop="8dp" />

        <!-- HASIL -->
        <LinearLayout
            android:id="@+id/cardHasil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginTop="12dp"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/tvVerdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BELI"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#16C784" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skor sinyal: +5 dari 13 indikator"
                    android:textSize="13sp"
                    android:textColor="#8B93A7"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alasan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:id="@+id/listAlasan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:elevation="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rincian Indikator"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:id="@+id/listRincian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="8dp"
                android:elevation="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analisa ini dihitung otomatis dari indikator teknikal untuk tujuan edukasi, BUKAN rekomendasi investasi. Keputusan beli/jual sepenuhnya tanggung jawab Anda."
                android:textSize="11sp"
                android:textColor="#8B93A7"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<include layout="@layout/bottom_nav" />
</LinearLayout>
