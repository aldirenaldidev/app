<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvRankNo"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#8B93A7" />

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp">
        <ImageView
            android:id="@+id/ivRankLogo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:background="@drawable/logo_bg"
            android:contentDescription="Logo emiten" />
        <TextView
            android:id="@+id/tvRankLogoInit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="BB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/pill_senja" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/tvRankSym" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BBCA" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/tvRankSharia" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SYARIAH" android:textSize="10sp" android:textStyle="bold" android:textColor="#16C784"
            android:background="@drawable/pill_sharia" android:paddingLeft="8dp" android:paddingRight="8dp"
            android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginTop="4dp"
            android:visibility="gone" />
        <TextView android:id="@+id/tvRankName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Bank Central Asia" android:textSize="12sp" android:textColor="#8B93A7" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">
        <TextView android:id="@+id/tvRankPrice" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="10.500" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/tvRankChg" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+2,50%" android:textSize="13sp" android:textStyle="bold" android:textColor="#16C784"
            android:background="@drawable/pill_up" android:paddingLeft="10dp" android:paddingRight="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
