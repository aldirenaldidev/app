<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/tvASym" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BBCA" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/tvACond" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Naik menyentuh ≥ 10.500" android:textSize="13sp" android:textColor="#8B93A7" />
        <TextView android:id="@+id/tvAState" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Aktif" android:textSize="12sp" android:textStyle="bold" android:textColor="#16C784" />
    </LinearLayout>

    <Button android:id="@+id/btnAToggle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Nonaktifkan" android:textSize="12sp" android:textColor="#FFFFFF"
        android:background="@drawable/input_bg" android:paddingLeft="10dp" android:paddingRight="10dp" />
    <Button android:id="@+id/btnADel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="✕" android:textColor="#EA3943" android:background="@android:color/transparent"
        android:layout_marginStart="4dp" />
</LinearLayout>
