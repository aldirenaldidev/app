<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp">

    <TextView android:id="@+id/tvNTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Judul berita" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF"
        android:lineSpacingExtra="2dp" />
    <TextView android:id="@+id/tvNMeta" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="CNBC Indonesia • 07 Okt 13:00" android:textSize="12sp" android:textColor="#8B93A7"
        android:layout_marginTop="6dp" />
</LinearLayout>
