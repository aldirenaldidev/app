<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol Instagram premium: gradient khas IG + pressed state halus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#6F3199"
                android:centerColor="#D71919"
                android:endColor="#D69638" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#833AB4"
                android:centerColor="#FD1D1D"
                android:endColor="#FCB045" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
